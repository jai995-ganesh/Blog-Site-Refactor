/* ================= GENERAL ================= */

body {
    background-color: #f5f7fa;
    color: #212529;
}


/* ================= SIDEBAR ================= */

.sidebar {
    background-color: #ffffff;

    padding: 20px;

    border-radius: 8px;

    border: 1px solid #dee2e6;

    height: 100%;
}

.sidebar h3 {
    font-weight: 600;
}

.sidebar p {
    margin-bottom: 10px;
}


/* ================= BLOG CARDS ================= */

.blog-card {
    border: none;

    border-radius: 10px;

    overflow: hidden;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);
}

.blog-card img {
    height: 300px;

    object-fit: cover;
}

.blog-card .card-body {
    padding: 25px;
}


/* ================= CONTENT BOX ================= */

.content-box {
    background-color: #ffffff;

    padding: 35px;

    border-radius: 10px;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.10);
}


/* ================= NAVBAR ================= */

.navbar-brand {
    letter-spacing: 1px;
}


/* ================= FOOTER ================= */

footer {
    margin-top: 50px;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 767px) {

    .blog-card img {
        height: 220px;
    }

    .content-box {
        padding: 20px;
    }

}